<section class="category-section collection-category">
  <div class="container">
    {% content_for 'blocks' %}
  </div>
</section>
<!-- collection-category-section end -->

<!-- collection section start -->
<section class="collection-section">
  <div class="container">
    <form id="CollectionFilterForm" method="get" action="{{ collection.url }}">
      <div class="collection-wrapper">
        <div class="collection-filter">
          {% content_for 'block', type: '_collection-filters', id: 'filters' %}
        </div>
        <div class="collection-content">
          {% content_for 'block', type: '_collection-toolbar', id: 'toolbar' %}
          {% content_for 'block', type: '_collection-product-grid', id: 'product-grid' %}
        </div>
      </div>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    { "type": "collection-heading" },
    { "type": "collection-category-slider" },
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Collection page",
      "blocks": {
        "heading": { "type": "collection-heading" },
        "category_slider": { "type": "collection-category-slider" }
      },
      "block_order": ["heading", "category_slider"]
    }
  ]
}
{% endschema %}
