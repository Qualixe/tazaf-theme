{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
%}

<section class="hero-section">
  <div class="container">
    <div class="swiper hero-slider">
      <div class="swiper-wrapper">
        {% for block in slide_blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="slider-hero-item">
              {% if block.settings.desktop_image != blank %}
                <img
                  src="{{ block.settings.desktop_image | image_url: width: 1920 }}"
                  alt="{{ block.settings.desktop_image.alt | default: block.settings.heading | escape }}"
                  width="{{ block.settings.desktop_image.width }}"
                  height="{{ block.settings.desktop_image.height }}"
                  class="desktop-img"
                  {% if forloop.first %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {% endif %}
              {% if block.settings.mobile_image != blank %}
                <img
                  src="{{ block.settings.mobile_image | image_url: width: 768 }}"
                  alt="{{ block.settings.mobile_image.alt | default: block.settings.heading | escape }}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                  class="mobile-img"
                  {% if forloop.first %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {% endif %}
              <div class="slider-hero-overlay">
                <div class="container">
                  <div class="hero-content-inner">
                    <div class="hero-content">
                      {% if block.settings.heading != blank %}
                        <h1 class="hero-content-heading">{{ block.settings.heading }}</h1>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination hero-pagination"></div>
      <div class="swiper-button-prev hero-button-prev"></div>
      <div class="swiper-button-next hero-button-next"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Premium product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
