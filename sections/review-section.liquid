{{ 'review-tab-section.css' | asset_url | stylesheet_tag }}

{% liquid
  assign product = closest.product
  assign product_rating = product.metafields.reviews.rating.value | default: 0 | times: 1.0 | round: 1
  assign product_rating_count = product.metafields.reviews.rating_count.value | default: 0

  assign category_collection = section.settings.category_collection
  assign category_rating = category_collection.metafields.reviews.rating.value | default: 0 | times: 1.0 | round: 1
  assign category_rating_count = category_collection.metafields.reviews.rating_count.value | default: 0

  assign write_review_url = section.settings.write_review_url | default: '#!'
  assign all_product_reviews_url = section.settings.all_product_reviews_url | default: '#!'
  assign all_category_reviews_url = section.settings.all_category_reviews_url | default: '#!'
%}

<section class="review-tab-section">
  <div class="container">
    <h2 class="review-tab-section-title">{{ section.settings.heading }}</h2>
    <div class="review-tab-nav">
      <button class="review-tab-nav-item active" type="button" data-review-tab="product-reviews">Product
        Reviews</button>
      <button class="review-tab-nav-item" type="button" data-review-tab="category-reviews">Category
        Reviews</button>
    </div>
    <div class="review-tab-panels">
      <div class="review-tab-panel active" id="product-reviews">
        <div class="review-summary-card">
          <div class="review-summary-left">
            <p class="review-summary-score">{{ product_rating }}</p>
            <div class="review-summary-content">
              <p class="review-summary-meta-text">Based on <strong>{{ product_rating_count }} Reviews</strong></p>
              <div class="review-summary-stars">
                {% for i in (1..5) %}
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path
                      d="M10 1.5 12.47 6.5 18 7.3 14 11.2 14.94 16.7 10 14 5.06 16.7 6 11.2 2 7.3 7.53 6.5 10 1.5Z"
                      stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
                  </svg>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="review-summary-btn">
            <a href="{{ write_review_url }}" class="btn">Write a review</a>
          </div>
        </div>
        <div class="review-summary-divider"></div>
        <div class="review-all-link-wrap">
          <a href="{{ all_product_reviews_url }}" class="review-all-link">Read All Product Reviews <span>›</span></a>
        </div>
      </div>
      <div class="review-tab-panel" id="category-reviews">
        <div class="review-summary-card">
          <div class="review-summary-left">
            <p class="review-summary-score">{{ category_rating }}</p>
            <div>
              <p class="review-summary-meta-text">Based on <strong>{{ category_rating_count }} Reviews</strong></p>
              <div class="review-summary-stars">
                {% for i in (1..5) %}
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <path
                      d="M10 1.5 12.47 6.5 18 7.3 14 11.2 14.94 16.7 10 14 5.06 16.7 6 11.2 2 7.3 7.53 6.5 10 1.5Z"
                      stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
                  </svg>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="review-summary-btn">
            <a href="{{ write_review_url }}" class="btn">Write a review</a>
          </div>
        </div>
        <div class="review-summary-divider"></div>
        <div class="review-all-link-wrap">
          <a href="{{ all_category_reviews_url }}" class="review-all-link">Read All Category Reviews <span>›</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Review tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ratings & Reviews"
    },
    {
      "type": "url",
      "id": "write_review_url",
      "label": "\"Write a review\" link"
    },
    {
      "type": "url",
      "id": "all_product_reviews_url",
      "label": "\"Read all product reviews\" link"
    },
    {
      "type": "collection",
      "id": "category_collection",
      "label": "Category",
      "info": "Collection used for the aggregate \"Category Reviews\" rating. Reads the collection's reviews.rating / reviews.rating_count metafields."
    },
    {
      "type": "url",
      "id": "all_category_reviews_url",
      "label": "\"Read all category reviews\" link"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Review tabs"
    }
  ]
}
{% endschema %}
