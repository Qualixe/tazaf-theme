<section class="section img-text-section{% if section.settings.reverse_layout %} img-text-section-reverse{% endif %}">
  <div class="container">
    <div class="img-text-section-wrapper">
      {% content_for 'block', type: 'image-text-image', id: 'image' %}
      <div class="img-text-section-content">
        {% content_for 'block', type: 'image-text-title', id: 'title' %}
        {% content_for 'block', type: 'image-text-text', id: 'text' %}
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "blocks": [
    { "type": "image-text-image" },
    { "type": "image-text-title" },
    { "type": "image-text-text" },
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout",
      "info": "Show the text before the image, and align text to the right.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": {
        "image": { "type": "image-text-image" },
        "title": {
          "type": "image-text-title",
          "settings": { "title": "Who we are?" }
        },
        "text": {
          "type": "image-text-text",
          "settings": {
            "text": "<p>Tazaf Ltd. one of the most popular and trusted brand names in the fashion industry of Bangladesh is mostly famous for the multi-collection of both domestic and internationally renowned brand products along with our brand products.</p><p>As a retailer of our parent brand Top Fabrics &amp; Tailors we started our journey in 2015. Within a short time, we achieved an astonishing improvement in the trendy sector. Now having 12 outlets at the prominent palaces, we have a strong setup in the fashion industry of Bangladesh. Tazaf Ltd. is inspired by our valued customers who are aware of modern and eccentric fashion. Since our inception we are offering world-class designed, aristocratic fashion items emphasizing the demand and desire of the customer at amazing prices.</p>"
          }
        }
      },
      "block_order": ["image", "title", "text"]
    }
  ]
}
{% endschema %}
