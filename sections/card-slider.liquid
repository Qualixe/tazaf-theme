<section class="card-slider-section section-bg">
  <div class="container">
    <div class="card-slider-section-heading-wrap">
      {% if section.settings.heading_image != blank %}
        <div class="img">
          <img
            src="{{ section.settings.heading_image | image_url: width: 400 }}"
            alt="{{ section.settings.heading_image.alt | escape }}"
            width="{{ section.settings.heading_image.width }}"
            height="{{ section.settings.heading_image.height }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      {% if section.settings.show_countdown %}
        <!-- count-down -->
        <div class="countdown" data-end="{{ section.settings.countdown_end }}">
          <span class="countdown-label">Ends In</span>
          <span class="countdown-time">
            <span class="countdown-days">00</span>
            <span class="countdown-unit">d</span>
            <span class="countdown-separator">:</span>
            <span class="countdown-hours">00</span>
            <span class="countdown-unit">h</span>
            <span class="countdown-separator">:</span>
            <span class="countdown-minutes">00</span>
            <span class="countdown-unit">m</span>
            <span class="countdown-separator">:</span>
            <span class="countdown-seconds">00</span>
            <span class="countdown-unit">s</span>
          </span>
        </div>
      {% endif %}
    </div>

    {% if section.settings.collection == blank and request.design_mode %}
      <p class="card-slider-section-placeholder">Select a collection in the section settings to show products here.</p>
    {% endif %}

    <div class="swiper card-slider">
      <div class="swiper-wrapper">
        {% for product in section.settings.collection.products limit: section.settings.max_products %}
          {% assign hover_image = product.images[1] | default: product.featured_image %}
          <div class="swiper-slide">
            <div class="card-slider-item">
              <div class="product-card card_hover">
                <div class="card-image-wrap">
                  {% if product.metafields.reviews.rating.value != blank %}
                    <div class="card-rattings">
                      <span class="icon">
                        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="pdp-star-icon is-filled">
                          <path
                            d="M8 1.333l2.06 4.174 4.607.67-3.333 3.249.786 4.587L8 11.846l-4.12 2.167.787-4.587L1.333 6.177l4.607-.67L8 1.333Z"
                            fill="currentColor"
                          ></path>
                        </svg>
                      </span>
                      <span class="rattings-count">{{ product.metafields.reviews.rating.value }}</span>
                      <span class="rattings-number">({{ product.metafields.reviews.rating_count.value | default: 0 }}+)</span>
                    </div>
                  {% endif %}
                  <div class="card-img">
                    <a class="main-img" href="{{ product.url }}">
                      {% if product.featured_image != blank %}
                        <img
                          class="card_img"
                          src="{{ product.featured_image | image_url: width: 500 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                          loading="lazy"
                        >
                      {% endif %}
                    </a>
                    <a class="hover-img" href="{{ product.url }}">
                      {% if hover_image != blank %}
                        <img
                          class="card_hover_img"
                          src="{{ hover_image | image_url: width: 500 }}"
                          alt="{{ product.title | escape }}"
                          width="{{ hover_image.width }}"
                          height="{{ hover_image.height }}"
                          loading="lazy"
                        >
                      {% endif %}
                    </a>
                  </div>
                </div>
                <div class="card-content">
                  <div class="card-title-wrap">
                    <a href="{{ product.url }}" class="card-title">{{ product.title }}</a>
                  </div>
                  <div class="card-price-wrap">
                    <p class="latest-price">{{ product.price | money }}</p>
                    {% if product.compare_at_price > product.price %}
                      <p class="previous-price">{{ product.compare_at_price | money }}</p>
                      <span class="card-badge">
                        {{
                          product.compare_at_price
                          | minus: product.price
                          | times: 100.0
                          | divided_by: product.compare_at_price
                          | round
                        }}% off
                      </span>
                    {% endif %}
                  </div>
                  <div class="card-btn">
                    <button
                      type="button"
                      class="btn"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      {% unless product.selected_or_first_available_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {% if product.selected_or_first_available_variant.available %}
                        add to cart
                      {% else %}
                        sold out
                      {% endif %}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="card-slider-section-btn">
      <a href="{{ section.settings.view_all_link | default: section.settings.collection.url }}" class="btn">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deal of the day slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "Heading image",
      "info": "Decorative heading image (e.g. a \"Deal of the Day\" graphic)."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown end date",
      "default": "2026-08-29T23:59:59",
      "info": "Format: YYYY-MM-DDTHH:MM:SS",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" button label",
      "default": "View All products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" button link",
      "info": "Defaults to the collection page if left blank."
    }
  ],
  "presets": [
    {
      "name": "Deal of the day slider"
    }
  ]
}
{% endschema %}
