<section class="card-slider-section section-bg" style="background-color: {{ section.settings.background_color }}; {% if section.settings.margin %}margin-top: 60px; margin-bottom: 60px;{% endif %}">
  <div class="container">
    <div class="card-slider-section-heading-wrap">
      {% content_for 'block', type: 'card-slider-heading', id: 'heading' %}
      {% content_for 'block', type: 'card-slider-heading-image', id: 'heading_image' %}
      {% content_for 'block', type: 'card-slider-countdown', id: 'countdown' %}
    </div>

    {% content_for 'block', type: 'card-slider-collection', id: 'collection' %}

    {% content_for 'block', type: 'card-slider-button', id: 'button' %}
  </div>
</section>

{% schema %}
{
  "name": "Products",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type":"checkbox",
      "id": "margin",
      "label": "margin",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fef2f0"
    }
  ],
  "blocks": [
    { "type": "card-slider-heading" },
    { "type": "card-slider-heading-image" },
    { "type": "card-slider-countdown" },
    { "type": "card-slider-collection" },
    { "type": "card-slider-button" }
  ],
  "presets": [
    {
      "name": "Products",
      "blocks": {
        "heading_image": {
          "type": "card-slider-heading-image"
        },
        "countdown": {
          "type": "card-slider-countdown"
        },
        "collection": {
          "type": "card-slider-collection",
          "settings": { "max_products": 8 }
        },
        "button": {
          "type": "card-slider-button" 
        }
      },
      "block_order": ["heading_image", "countdown", "collection", "button"]
    }
  ]
}
{% endschema %}
