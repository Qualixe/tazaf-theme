{{'img-text-grid-section.css' | asset_url |stylesheet_tag }}
<section class="section img-text-grid-section">
  <div class="container">
    {% content_for 'block', type: 'img-text-grid-heading', id: 'heading' %}
    <div class="img-text-grid-wrap">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

