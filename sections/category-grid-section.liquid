{% liquid
  assign grid_blocks = section.blocks | where: 'type', 'item'
%}

<section class="category-grid-section">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="category-grid-heading">
        <h2 class="category-grid-title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}
    <div class="category-grid-items">
      {% for block in grid_blocks %}
        <a href="{{ block.settings.link | default: '#' }}" class="category-grid-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 500 }}"
              alt="{{ block.settings.image.alt | default: section.settings.title | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Wall Edit"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
