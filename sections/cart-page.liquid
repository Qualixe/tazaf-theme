<section class="cart-section" data-section-id="{{ section.id }}">
  <div class="container">
    {% content_for 'block', type: 'cart-page-heading', id: 'heading' %}
    <div class="cart-wrapper">
      <div class="cart-content-wrap">
        {% content_for 'block', type: '_cart-page-items', id: 'items' %}
        {% content_for 'blocks' %}
      </div>
      {% content_for 'block', type: '_cart-page-summary', id: 'summary' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart page",
  "enabled_on": {
    "templates": ["cart"]
  },
  "blocks": [
    { "type": "cart-page-discount" },
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Cart page",
      "blocks": {
        "discount": { "type": "cart-page-discount" }
      },
      "block_order": ["discount"]
    }
  ]
}
{% endschema %}
