{{ 'product-section.css' | asset_url | stylesheet_tag: preload: true }}

{% liquid
  assign preorder = false
  for tag in product.tags
    if tag contains 'preorder'
      assign preorder = true
    else 
      assign preorder = false
    endif
  endfor
%}

{% render 'breadcrumb', type: 'product' %} 
<section class="product-section">
  <div class="container">
    <div class="product-page-content-wrap">
      <div class="product-slider-area">
        <div class="product-slider-inner">
          <div class="swiper product-slider">
            <div class="swiper-wrapper">
              {% for media in closest.product.media %}
                {% if media.media_type == 'image' %}
                  {% liquid
                    assign media_alt = media.alt | default: closest.product.title | escape
                    assign media_loading = 'lazy'
                    if forloop.first
                      assign media_loading = 'eager'
                    endif
                  %}
                  <div class="swiper-slide" data-media-id="{{ media.id }}">
                    <div class="product-slider-img">
                      {{ media | image_url: width: 800 | image_tag: alt: media_alt, loading: media_loading }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="swiper-pagination product-slider-pagination"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>

            {% if preorder %}
              <div class="pre-order">
                Pre Order
              </div>
            {% endif %}
            
          </div>
          <div class="swiper product-slider-thumb">
            <div class="swiper-wrapper">
              {% for media in closest.product.media %}
                {% if media.media_type == 'image' %}
                  {% assign media_alt = media.alt | default: closest.product.title | escape %}
                  <div class="swiper-slide">
                    <div class="product-slider-img">
                      {{ media | image_url: width: 200 | image_tag: alt: media_alt, loading: 'lazy' }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="product-content-area">
        <div class="product-content-inner">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</section>

{% render 'product-modal' %}
{% render 'size-chart-sidebar' %}

<script type="application/json" data-product-variants>
  {{ closest.product.variants | json }}
</script>

{% render 'product-info', product: product %}

{% render 'floating-cart', product: product %}

{% schema %}
{
  "name": "Product information",
  "settings": [],
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    { "type": "product-info-rating" },
    { "type": "product-info-title" },
    { "type": "product-info-price" },
    { "type": "product-info-variant-picker" },
    { "type": "product-info-combo-offer" },
    { "type": "product-info-quantity" },
    { "type": "product-info-buy-buttons" },
    { "type": "product-info-brand-logo" },
    { "type": "product-info-badges" },
    { "type": "product-info-accordion" }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": {
        "rating": { "type": "product-info-rating" },
        "title": { "type": "product-info-title" },
        "price": { "type": "product-info-price" },
        "variant_picker": {
          "type": "product-info-variant-picker",
          "settings": { "show_size_guide": true }
        },
        "combo_offer": {
          "type": "product-info-combo-offer",
          "blocks": {
            "option-1": {
              "type": "product-info-combo-option",
              "settings": { "title": "Buy 1 product", 
              "checked": true }
            },
            "option-2": {
              "type": "product-info-combo-option",
              "settings": {
                "title": "Buy 2 product",
                "badge_text": "Best Seller"
              }
            },
            "option-3": {
              "type": "product-info-combo-option",
              "settings": {
                "title": "Buy 3 product",
                "badge_text": "Best value"
              }
            }
          },
          "block_order": ["option-1", "option-2", "option-3"]
        },
        "quantity": { "type": "product-info-quantity" },
        "buy_buttons": {
          "type": "product-info-buy-buttons",
          "blocks": {
            "add_to_cart": { "type": "product-info-add-to-cart-button" },
            "buy_now": { "type": "product-info-buy-now-button" },
            "whatsapp": { "type": "product-info-whatsapp-button" },
            "call": { "type": "product-info-call-button" }
          },
          "block_order": ["add_to_cart", "buy_now", "whatsapp", "call"]
        },
        "brand_logo": { "type": "product-info-brand-logo" },
        "badges": {
          "type": "product-info-badges",
          "blocks": {
            "badge-1": {
              "type": "product-info-badge",
              "settings": { "icon": "shipping", "title": "Free expedited shipping" }
            },
            "badge-2": {
              "type": "product-info-badge",
              "settings": { "icon": "returns", "title": "Easy Returns Within 30 Days" }
            },
            "badge-3": {
              "type": "product-info-badge",
              "settings": { "icon": "secure", "title": "Safe & Secure Payments" }
            }
          },
          "block_order": ["badge-1", "badge-2", "badge-3"]
        },
        "accordion": {
          "type": "product-info-accordion",
          "blocks": {
            "description": { "type": "product-info-description-tab" },
            "specification": { "type": "product-info-specification-tab" },
            "return_policy": { "type": "product-info-return-policy-tab" }
          },
          "block_order": ["description", "specification", "return_policy"]
        }
      },
      "block_order": [
        "rating",
        "title",
        "price",
        "variant_picker",
        "combo_offer",
        "quantity",
        "buy_buttons",
        "brand_logo",
        "badges",
        "accordion"
      ]
    }
  ]
}
{% endschema %}
