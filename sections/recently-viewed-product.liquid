<script
  src="{{ 'recently-viewed-product.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<section class="card-slider-section section-bg" {% if search.results == blank %}hidden{% endif %}>
  <recently-viewed-product
    data-section-id="{{ section.id }}"
    data-current-product-id="{{ closest.product.id }}"
    hidden
  ></recently-viewed-product>

  <div class="container">
    <div class="card-slider-section-heading">
      <h2 class="title">{{ section.settings.heading }}</h2>
    </div>
    <div class="swiper card-slider">
      <div class="swiper-wrapper">
        {% for product in search.results %}
          <div class="swiper-slide">
            <div class="card-slider-item">
              {% render 'slider-product-card', product: product %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="card-slider-section-btn">
      <a href="{{ routes.search_url }}?type=product&q={{ search.terms | url_encode }}" class="btn">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed Products"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" button label",
      "default": "View All products"
    }
  ],
  "presets": [
    {
      "name": "Recently viewed products"
    }
  ]
}
{% endschema %}
