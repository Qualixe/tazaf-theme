<section class="category-section collection-category" id="search_results">
  <div class="container">
    <div class="category-section-heading">
      {% if search.performed and search.terms != blank %}
        <h1 class="title h5">Search results for "{{ search.terms | escape }}"</h1>
      {% else %}
        <h1 class="title h5">Search</h1>
      {% endif %}
      {% if search.performed %}
        <span class="category-heading-separator"></span>
        <span class="collection-count">{{ search.results_count }} Products</span>
      {% endif %}
    </div>
  </div>
</section>

<section class="collection-section">
  <div class="container">
    <form id="CollectionFilterForm" method="get" action="{{ routes.search_url }}">
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <div class="collection-wrapper">
        {% if search.filters.size > 0 %}
          <div class="collection-filter">
            {% content_for 'block', type: '_search-filters', id: 'filters' %}
          </div>
        {% endif %}
        <div class="collection-content">
          {% content_for 'block', type: '_search-toolbar', id: 'toolbar' %}
          {% content_for 'block', type: '_search-product-grid', id: 'product-grid' %}
        </div>
      </div>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Search Results"
    }
  ]
}
{% endschema %}
