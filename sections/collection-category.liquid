{% assign collection_list = product.metafields.custom.collections.value %}
{% if collection_list.size > 0 %}
  

<section class="category-section product-category collection-category">
  <div class="container">
    <div class="category-section-heading">
      <h2 class="title h5">{{ section.settings.heading }}</h2>
    </div>

    

    {% if section.settings.collection_list == blank and request.design_mode %}
      <p class="card-slider-section-placeholder">Select collections in the section settings to show categories here.</p>
    {% endif %}

    <div class="category-wrapper">
      <div class="category-slider-wrapper">
        <div class="swiper collection-category-slider">
          <div class="swiper-wrapper">
            {% for collection in collection_list %}
              {% assign collection_image_alt = collection.featured_image.alt | default: collection.title | escape %}
              <div class="swiper-slide">
                <a href="{{ collection.url }}" class="category-item">
                  <div class="img">
                    {% if collection.image != blank %}
                      {{
                        collection.image
                        | image_url: width: 1000
                        | image_tag: alt: collection_image_alt, loading: 'lazy'
                      }}
                    {% else %}
                      {{
                        collection.featured_image
                        | image_url: width: 1000
                        | image_tag: alt: collection_image_alt, loading: 'lazy'
                      }}
                    {% endif %}
                  </div>
                  <div class="content">
                    <p class="title">{{ collection.title }}</p>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-button-prev collection-category-button-prev"></div>
          <div class="swiper-button-next collection-category-button-next"></div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Category slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore More in Categories"
    }
  ],
  "presets": [
    {
      "name": "Category slider"
    }
  ]
}
{% endschema %}
