{% liquid
  assign banner_blocks = section.blocks | where: 'type', 'banner'
%}

<section class="grid-banner-section">
  <div class="container">
    <div class="grid-banner-items">
      {% for block in banner_blocks %}
        <div class="grid-banner-item grid-banner-item{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a class="grid-banner-item-inner" href="{{ block.settings.link | default: '/collections/all' }}">
            <div class="grid-banner-item-img">
              {% if block.settings.desktop_image != blank %}
                <img
                  src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
                  alt="{{ block.settings.desktop_image.alt | default: block.settings.heading | escape }}"
                  width="{{ block.settings.desktop_image.width }}"
                  height="{{ block.settings.desktop_image.height }}"
                  class="desktop-img"
                  loading="lazy"
                >
              {% endif %}
              {% if block.settings.mobile_image != blank %}
                <img
                  src="{{ block.settings.mobile_image | image_url: width: 750 }}"
                  alt="{{ block.settings.mobile_image.alt | default: block.settings.heading | escape }}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                  class="mobile-img"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <div class="grid-banner-item-content">
              <div class="grid-banner-item-content-inner">
                {% if block.settings.heading != blank %}
                  <h2 class="grid-banner-item-content-title">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="grid-banner-item-content-text">{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <div class="btn secondary-btn">{{ block.settings.button_label }}<span></span></div>
                {% endif %}
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grid banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "This layout has 3 fixed slots: the 1st banner is the large left tile, the 2nd is top-right, the 3rd is bottom-right. Reordering blocks changes which banner appears in which slot."
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid banner",
      "blocks": [
        {
          "type": "banner",
          "settings": { "heading": "New premium dress", "text": "Explore living" }
        },
        {
          "type": "banner",
          "settings": { "heading": "Ready to wear", "text": "Explore living" }
        },
        {
          "type": "banner",
          "settings": { "heading": "Ready to wear", "text": "Explore living" }
        }
      ]
    }
  ]
}
{% endschema %}
