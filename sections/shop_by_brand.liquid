{% liquid
  assign brand_blocks = section.blocks | where: 'type', 'brand'
%}

<section class="shop-by-brand-section">
  {% comment %} <div class="container">
    <div class="shop-by-brand-heading">
      {% if section.settings.title != blank %}
        <h2 class="title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.view_all_label != blank %}
        <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="shop-by-brand-all-link">
          {{ section.settings.view_all_label }} <span>›</span>
        </a>
      {% endif %}
    </div>
    <div class="swiper shop-by-brand-slider">
      <div class="swiper-wrapper">
        {% for block in brand_blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="shop-by-brand-item">
              {% if block.settings.logo != blank %}
                <img
                  src="{{ block.settings.logo | image_url: width: 300 }}"
                  alt="{{ block.settings.logo.alt | default: block.settings.name | escape }}"
                  width="{{ block.settings.logo.width }}"
                  height="{{ block.settings.logo.height }}"
                  loading="lazy"
                >
              {% else %}
                <p class="wordmark">{{ block.settings.name }}</p>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div> {% endcomment %}
  <div class="container">
    <div class="shop-by-brand-heading">
      {% if section.settings.title != blank %}
        <h2 class="title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.view_all_label != blank %}
        <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="shop-by-brand-all-link">
          {{ section.settings.view_all_label }} <span>›</span>
        </a>
      {% endif %}
    </div>
    <div class="swiper shop-by-brand-slider">
      <div class="swiper-wrapper">
        {% for block in brand_blocks %}
          {% assign brand_info = block.settings.brand %}

          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a href="{{ routes.collections_url }}/vendors?q={{ brand_info.name | url_encode }}" class="shop-by-brand-item">
              {% if  brand_info.logo != blank %}
                <img
                  src="{{  brand_info.logo | image_url: width: 1000 }}"
                  alt="{{  brand_info.logo.alt | default:  brand_info.logo.name | escape }}"
                  width="{{  brand_info.logo.width }}"
                  height="{{  brand_info.logo.height }}"
                  loading="lazy"
                >
              {% else %}
                <p class="wordmark">{{  brand_info.name }}</p>
              {% endif %}
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by brand",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop By Brands"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" link label",
      "default": "Shop All Brands"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" link"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "metaobject",
          "id": "brand",
          "label": "Brand",
          "metaobject_type": "brand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by brand",
      "blocks": [
        { "type": "brand"},
        { "type": "brand"},
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
