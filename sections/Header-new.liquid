{% liquid
  assign nav_blocks = section.blocks | where: 'type', 'menu_item'
  assign search_term_blocks = section.blocks | where: 'type', 'search_term'
  assign popular_search_blocks = section.blocks | where: 'type', 'popular_search'
  assign search_category_blocks = section.blocks | where: 'type', 'search_category'
  assign tmpt = template.name
%}

<header class="header home-nav-active{% if tmpt contains 'index' %} home-header{% elsif tmpt contains 'product' %} product-page-header{% endif %}">
  <div class="container">
    <nav class="navbar">
      <div class="navbar-left">
        <button class="hamburger app-menu-open" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24px" height="24px"><path d="M 3 5 A 1.0001 1.0001 0 1 0 3 7 L 21 7 A 1.0001 1.0001 0 1 0 21 5 L 3 5 z M 3 11 A 1.0001 1.0001 0 1 0 3 13 L 21 13 A 1.0001 1.0001 0 1 0 21 11 L 3 11 z M 3 17 A 1.0001 1.0001 0 1 0 3 19 L 21 19 A 1.0001 1.0001 0 1 0 21 17 L 3 17 z"/></svg>
        </button>
        <div class="navbar-logo">
          <a href="{{ routes.root_url }}">
            {% if settings.logo != blank %}
              <img
                src="{{ settings.logo | image_url: width: 300 }}"
                alt="{{ settings.logo.alt | default: shop.name | escape }}"
                width="{{ settings.logo.width }}"
                height="{{ settings.logo.height }}"
                loading="eager"
              >
            {% else %}
              {{ shop.name }}
            {% endif %}
          </a>
        </div>
      </div>

      <div class="navbar-search">
        <button class="search-open navbar-search-open-btn" aria-label="Open search">
          <span class="icon">
            <svg viewBox="0 0 20 20" fill="none">
              <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="text p">
            search for
            <span class="search-roller">
              <span class="search-roller-track">
                {% for block in search_term_blocks %}
                  <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
                {% endfor %}
              </span>
            </span>
          </span>
        </button>
      </div>

      <div class="navbar-icons">
        <button class="navbar-icon navbar-search-open-btn" aria-label="Search">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <a href="{{ routes.account_url }}" class="navbar-icon" aria-label="Account">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 10.1A2.85 2.85 0 1 0 10 4.4a2.85 2.85 0 0 0 0 5.7Z" stroke="currentColor" stroke-width="1.4"></path>
            <path
              d="M4.6 16c.45-2.25 2.48-3.7 5.4-3.7 2.92 0 4.95 1.45 5.4 3.7"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
            ></path>
          </svg>
        </a>
        <button class="navbar-icon cart-drawer-open" aria-label="Cart">
          <span class="cart-count">{{ cart.item_count }}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M2.5 3.5H4.6l1.6 7.7c.17.82.89 1.4 1.73 1.4h6.17c.82 0 1.53-.55 1.73-1.34l1.3-5.16H5.3"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <circle cx="8.2" cy="15.6" r="1.1" fill="currentColor"></circle>
            <circle cx="14.1" cy="15.6" r="1.1" fill="currentColor"></circle>
          </svg>
        </button>
      </div>

      <div class="navbar-link-area">
        <ul class="navbar-links">
          {% for block in nav_blocks %}
            <li class="navbar-link" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="navbar-link-btn">{{ block.settings.title }}</a>
              {% else %}
                <p class="navbar-link-btn">{{ block.settings.title }}</p>
              {% endif %}

              {% if block.settings.menu != blank %}
                <div class="megamenu">
                  <div class="megamenu-items">
                    {% for column in block.settings.menu.links %}
                      <div class="megamenu-item">
                        <h6 class="megamenu-item-title">{{ column.title }}</h6>
                        <ul>
                          {% for link in column.links %}
                            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </nav>
  </div>
</header>


<!-- search-bar popup start -->
<div class="search-bar-wrap">
  <button class="search-bar-window-cls-btn" aria-label="Close search"></button>
  <div class="search-bar">
    <div class="search-bar-top">
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
        <div class="search-field">
          <span class="icon">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <path
                d="M14 14L11.1 11.1"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
          <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off">
          <input type="hidden" name="type" value="product">
        </div>
      </form>
      <button class="search-bar-close" aria-label="Close search">
        <svg width="16" height="16" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M9.85403 9.14653C9.90048 9.19298 9.93733 9.24813 9.96247 9.30883C9.98762 9.36953 10.0006 9.43458 10.0006 9.50028C10.0006 9.56598 9.98762 9.63103 9.96247 9.69173C9.93733 9.75242 9.90048 9.80757 9.85403 9.85403C9.80757 9.90048 9.75242 9.93733 9.69173 9.96247C9.63103 9.98762 9.56598 10.0006 9.50028 10.0006C9.43458 10.0006 9.36953 9.98762 9.30883 9.96247C9.24813 9.93733 9.19298 9.90048 9.14653 9.85403L5.00028 5.70715L0.854028 9.85403C0.760208 9.94785 0.63296 10.0006 0.500278 10.0006C0.367596 10.0006 0.240348 9.94785 0.146528 9.85403C0.0527077 9.76021 2.61548e-09 9.63296 0 9.50028C-2.61548e-09 9.3676 0.0527077 9.24035 0.146528 9.14653L4.2934 5.00028L0.146528 0.854028C0.0527077 0.760208 0 0.63296 0 0.500278C0 0.367596 0.0527077 0.240348 0.146528 0.146528C0.240348 0.0527077 0.367596 0 0.500278 0C0.63296 0 0.760208 0.0527077 0.854028 0.146528L5.00028 4.2934L9.14653 0.146528C9.24035 0.0527077 9.3676 -2.61548e-09 9.50028 0C9.63296 2.61548e-09 9.76021 0.0527077 9.85403 0.146528C9.94785 0.240348 10.0006 0.367596 10.0006 0.500278C10.0006 0.63296 9.94785 0.760208 9.85403 0.854028L5.70715 5.00028L9.85403 9.14653Z"
            fill="#0B0802"
          ></path>
        </svg>
      </button>
    </div>

    <div class="search-bar-btm">
      <div class="search-history">
        <div class="search-history-items">
          {% if popular_search_blocks.size > 0 %}
            <div class="search-history-item">
              <p class="search-history-item-title">most searched</p>
              <div class="search-tags">
                {% for block in popular_search_blocks %}
                  <a href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
                    {{ block.settings.title }}
                    <span class="icon">
                      <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M3.5 8.5L8.5 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path
                          d="M4.00006 3.49997H8.50006V7.99997"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    </span>
                  </a>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if search_category_blocks.size > 0 %}
            <div class="search-history-item">
              <p class="search-history-item-title">Explore best category</p>
              <div class="search-categories">
                {% for block in search_category_blocks %}
                  <a href="{{ block.settings.link | default: '/collections/all' }}" class="search-category" {{ block.shopify_attributes }}>
                    <div class="search-category-img">
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 200 }}"
                          alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                          width="100"
                          height="100"
                          loading="lazy"
                        >
                      {% endif %}
                    </div>
                    <div class="search-category-content">
                      <p class="title">{{ block.settings.title }}</p>
                    </div>
                  </a>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="search-result-area">
        <div class="search-result">
          <p class="search-result-title">Search Results:</p>
          <div class="search-result-items" data-predictive-search-results>
            {% comment %} Populated at runtime by the predictive search script. {% endcomment %}
          </div>
          <div class="search-result-btn">
            <a href="{{ routes.search_url }}" class="btn">view all results</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- search-bar popup end -->

<!-- mobile-menu start -->
<div class="mobile-menu-wrap">
  <div class="mobile-menu-close-window-btn"></div>
  <div class="mobile-menu-container">
    <div class="mobile-menu-top">
      <button class="mobile-menu-close-btn" type="button" aria-label="Close menu">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M16 10H4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path d="M8 6L4 10L8 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <p class="mobile-menu-title">all categories</p>
      <button class="mobile-menu-search navbar-search-open-btn" aria-label="Search">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div class="mobile-menu-inner">
      <div class="mobile-menu-tabs">
        {% for block in nav_blocks %}
          <a
            href="#{{ block.settings.title | handleize }}"
            class="mobile-menu-tab{% if forloop.first %} active{% endif %}"
          >
            {% comment %}
            <span class="mobile-menu-tab-img">
              {% if block.settings.tab_image != blank %}
                <img
                  src="{{ block.settings.tab_image | image_url: width: 80 }}"
                  alt="{{ block.settings.tab_image.alt | default: block.settings.title | escape }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              {% endif %}
            </span>
            {% endcomment %}
            <span class="mobile-menu-tab-title">{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      </div>

      <div class="mobile-menu-tabs-contents">
        {% for block in nav_blocks %}
          <div class="mobile-menu-tabs-content" id="{{ block.settings.title | handleize }}">
            <div class="mobile-menu-tabs-content-heading">
              <p class="title">{{ block.settings.title }}</p>
              <span class="line"></span>
            </div>
            <div class="mobile-menu-tabs-content-items">
              {% if block.settings.menu != blank %}
                {% for column in block.settings.menu.links %}
                  <div class="mobile-menu-tabs-content-item">
                    <p class="mobile-menu-tabs-content-item-title">{{ column.title }}</p>
                    <div class="mobile-menu-tabs-content-item-grids">
                      {% for link in column.links %}
                        <a href="{{ link.url }}" class="mobile-menu-tabs-content-item-grid">
                          {% if link.type == 'collection_link' and link.object.image != blank %}
                            <span class="mobile-menu-tabs-content-item-grid-img">
                              <img
                                src="{{ link.object.image | image_url: width: 200 }}"
                                alt="{{ link.object.image.alt | default: link.title | escape }}"
                                width="100"
                                height="100"
                                loading="lazy"
                              >
                            </span>
                            {% else %}
                            <span class="mobile-menu-tabs-content-item-grid-img">
                              {{ 'image' |  placeholder_svg_tag: 'mega_menu_img' }}
                            </span>
                          {% endif %}
                          <span class="mobile-menu-tabs-content-item-grid-title">{{ link.title }}</span>
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<!-- mobile-menu end -->

{% schema %}
{
  "name": "Header",
  "settings": [],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Menu item"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Leave blank if this label should only open the mega menu."
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Mobile tab image"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Mega menu",
          "info": "Pick a menu from Navigation. Its top-level links become mega menu columns; their sub-links become each column's items."
        }
      ]
    },
    {
      "type": "search_term",
      "name": "Search suggestion",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "search term"
        }
      ]
    },
    {
      "type": "popular_search",
      "name": "Popular search",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Popular search"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "search_category",
      "name": "Search category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "menu_item",
          "settings": {
            "title": "Bedding"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Furnishings"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Kitchen"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Dining"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Decor"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Kids & Children"
          }
        },
        {
          "type": "search_term",
          "settings": {
            "text": "smart phone"
          }
        },
        {
          "type": "search_term",
          "settings": {
            "text": "home decoration"
          }
        },
        {
          "type": "search_term",
          "settings": {
            "text": "gadgets"
          }
        },
        {
          "type": "popular_search",
          "settings": {
            "title": "Wall paintings"
          }
        },
        {
          "type": "popular_search",
          "settings": {
            "title": "Bedsheets"
          }
        },
        {
          "type": "popular_search",
          "settings": {
            "title": "Rugs & Carpets"
          }
        },
        {
