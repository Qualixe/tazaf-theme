{%- doc -%}
  Renders a single product card used inside the swiper card sliders
  (card-slider, explore-more, recently-viewed-product, cart-drawer-new).

  @param {object} product - The product object
  @param {number} [image_width] - The width to request product images at. Defaults to 500.
  @param {boolean} [show_badge] - Whether to show the discount badge. Defaults to true.
  @param {string} [add_to_cart_label] - Label for the add to cart button. Defaults to 'add to cart'.
  @param {string} [sold_out_label] - Label for the sold out state. Defaults to 'sold out'.
{%- enddoc -%}

{% liquid
  assign image_width = image_width | default: 500
  assign show_badge = show_badge | default: true
  assign add_to_cart_label = add_to_cart_label | default: 'add to cart'
  assign sold_out_label = sold_out_label | default: 'sold out'

  assign hover_image = product.images[1] | default: product.featured_image
  assign featured_alt = product.featured_image.alt | default: product.title | escape
  assign title_escaped = product.title | escape
  assign current_variant = product.selected_or_first_available_variant
%}
<div class="product-card card_hover">
  <div class="card-image-wrap">
    
      <div class="card-rattings">
        {% render 'review', product: product %}
      </div>
    
    <div class="card-img">
      <a class="main-img" href="{{ product.url }}">
        {% if product.featured_image != blank %}
          {{ product.featured_image | image_url: width: image_width | image_tag: class: 'card_img', alt: featured_alt, loading: 'lazy' }}
        {% endif %}
      </a>
      <a class="hover-img" href="{{ product.url }}">
        {% if hover_image != blank %}
          {{ hover_image | image_url: width: image_width | image_tag: class: 'card_hover_img', alt: title_escaped, loading: 'lazy' }}
        {% endif %}
      </a>
    </div>
  </div>
  <div class="card-content">
    <div class="card-title-wrap">
      <a href="{{ product.url }}" class="card-title">{{ product.title  }}</a>
    </div>
    <div class="card-price-wrap">
      <p class="latest-price">{{ product.price | money_without_trailing_zeros }}</p>
      {% if product.compare_at_price > product.price %}
        <p class="previous-price">{{ product.compare_at_price | money_without_trailing_zeros }}</p>
        {% if show_badge %}
          <span class="card-badge">
            {{
              product.compare_at_price
              | minus: product.price
              | times: 100.0
              | divided_by: product.compare_at_price
              | round
            }}% off
          </span>
        {% endif %}
      {% endif %}
    </div>
    <div class="card-btn">
      <button
        type="button"
        class="btn add-to-cart-btn{% unless current_variant.available %} soldout{% endunless %}"
        data-variant-id="{{ current_variant.id }}"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="btn-label">
          {% if current_variant.available %}
            {{ add_to_cart_label }}
          {% else %}
            {{ sold_out_label }}
          {% endif %}
        </span>
        <span class="btn-spinner" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</div>
