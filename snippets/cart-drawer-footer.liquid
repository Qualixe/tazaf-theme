<div class="cart-drawer-footer">
  <div class="cart-drawer-total-wrap">
    <p class="cart-drawer-total-title">{{ block.settings.total_title | default: 'total' }}</p>
    <p class="cart-drawer-total-price">{{ cart.total_price | money }}</p>
  </div>
  <div class="cart-drawer-checkout-btn-wrap">
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn">{{ block.settings.checkout_text | default: 'secure checkout' }}</button>
    </form>
  </div>
</div>
