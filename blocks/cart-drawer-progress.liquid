{% liquid
  assign threshold = block.settings.threshold | default: 350000
  assign percent_value = cart.total_price | times: 100 | divided_by: threshold
  if percent_value > 100
    assign percent_value = 100
  endif
  assign remaining = threshold | minus: cart.total_price
%}

<div class="cart-drawer-progress" {{ block.shopify_attributes }}>
  <div class="cart-drawer-progress-content">
    <span class="icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>
    </span>
    <div class="content">
      <p class="title">{{ block.settings.title | default: 'Free Shipping' }}</p>
      <p class="text">
        {% if remaining > 0 %}
          Add <strong>{{ remaining | money }}</strong> more to unlock!
        {% else %}
          You've unlocked free shipping!
        {% endif %}
      </p>
    </div>
  </div>
  <input
    type="range"
    value="{{ percent_value }}"
    min="0"
    max="100"
    step="1"
    class="progress"
    disabled
    style="background: linear-gradient(to right, #d55a3c 0%, #422c26 {{ percent_value }}%, rgb(236 219 216) {{ percent_value }}%)"
  >
</div>

{% schema %}
{
  "name": "Cart progress",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Free Shipping"
    },
    {
      "type": "number",
      "id": "threshold",
      "label": "Threshold amount",
      "default": 350000
    }
  ],
  "presets": [
    {
      "name": "Cart progress",
      "category": "Cart drawer"
    }
  ]
}
{% endschema %}
