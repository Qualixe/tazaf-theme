{% assign brand = product.metafields.custom.brand.value %}

{% if brand.logo != blank %}
  {% assign brand_logo_alt = brand.logo.alt | default: shop.name | escape %}
  <a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}" class="product-brand-logo" {{ block.shopify_attributes }}>
    <p>brand:</p>
    {{ brand.logo | image_url: width: 160 | image_tag: alt: brand_logo_alt, loading: 'lazy' }}
  </a>
{% endif %}

{% schema %}
{
  "name": "Brand logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses the brand logo set in Theme settings > Product page."
    }
  ],
  "presets": [
    { "name": "Brand logo", "category": "Product" }
  ]
}
{% endschema %}
