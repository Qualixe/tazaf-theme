{% if settings.product_brand_logo != blank %}
  {% assign brand_logo_alt = settings.product_brand_logo.alt | default: shop.name | escape %}
  <div class="product-brand-logo" {{ block.shopify_attributes }}>
    <p>brand:</p>
    {{ settings.product_brand_logo | image_url: width: 160 | image_tag: alt: brand_logo_alt, loading: 'lazy' }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Brand logo",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses the brand logo set in Theme settings > Product page."
    }
  ],
  "presets": [
    { "name": "Brand logo", "category": "Product" }
  ]
}
{% endschema %}
