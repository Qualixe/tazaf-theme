{%- doc -%}
  Renders the cart page heading.
{%- enddoc -%}

<div class="section-heading-wrapper" {{ block.shopify_attributes }}>
  <h1 class="section-heading">{{ block.settings.heading }}</h1>
</div>

{% schema %}
{
  "name": "Cart heading",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Shopping Cart"
    }
  ],
  "presets": [
    {
      "name": "Cart heading"
    }
  ]
}
{% endschema %}
