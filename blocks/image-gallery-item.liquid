{%- doc -%}
  Renders one image in the image gallery grid, optionally linked.
{%- enddoc -%}

{% liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
  assign image_alt = block.settings.image.alt | default: ''
%}

<div class="image-gallary-item" {{ block.shopify_attributes }}>
  <{{ tag }}
    {% if tag == 'a' %}
      href="{{ block.settings.link }}"
    {% endif %}
    class="image-gallary-item-inner"
  >
    <div class="image-gallary-item-img">
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 800 | image_tag: alt: image_alt, loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="image-gallary-item-content">
      <div class="image-gallary-item-content-inner"></div>
    </div>
  </{{ tag }}>
</div>

{% schema %}
{
  "name": "Gallery image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the image clickable."
    }
  ],
  "presets": [
    {
      "name": "Gallery image"
    }
  ]
}
{% endschema %}
