<div class="product-icon-item" {{ block.shopify_attributes }}>
  <div class="icon">
    {% case block.settings.icon %}
      {% when 'returns' %}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 7v4h-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M20 11a8 8 0 1 0-2.34 5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          <path
            d="M12 7.5v9M14.5 9.5c0-1.1-.9-1.8-2.3-1.8s-2.3.7-2.3 1.8c0 1.2 1.1 1.6 2.3 2 1.2.4 2.3.8 2.3 2s-.9 1.8-2.3 1.8-2.3-.7-2.3-1.8"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
      {% when 'secure' %}
        <svg width="46" height="44" viewBox="0 0 46 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M38.4532 8.65158V12.8744L41.1485 14.12V3.14744C41.1485 1.41367 39.765 0 38.0681 0H8.47119C6.91303 0 5.60643 1.19593 5.41479 2.75391H32.681C35.8573 2.75391 38.4532 5.40638 38.4532 8.65158Z"
            fill="#2B2B2B"
          ></path>
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M0 13.7697V16.5236H22.3458C24.3157 15.5848 26.3233 14.6857 28.3063 13.7697H0Z"
            fill="#2B2B2B"
          ></path>
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M0 19.2774V27.4246C0 28.2906 0.345809 29.0769 0.90275 29.646C1.45978 30.215 2.22938 30.5684 3.07688 30.5684H20.125L20.1219 19.2773H0V19.2774Z"
            fill="#2B2B2B"
          ></path>
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M35.7578 8.65158C35.7578 7.78566 35.412 6.99933 34.855 6.43019C34.298 5.86105 33.5284 5.50781 32.6808 5.50781H3.07688C2.22938 5.50781 1.45978 5.86114 0.90275 6.43019C0.345809 6.99942 0 7.78566 0 8.65158V11.0156H35.7578V8.65158Z"
            fill="#2B2B2B"
          ></path>
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M45.9981 20.2653C45.9978 19.7415 45.703 19.2413 45.2051 19.0121L34.9017 14.2505C34.5625 14.0946 34.162 14.0821 33.7962 14.2505L23.5668 18.9763C23.0588 19.1735 22.6978 19.6756 22.6978 20.2638V28.7971C22.6978 32.1105 23.6308 35.3724 26.3141 37.445L33.521 43.0111C33.9897 43.3888 34.6657 43.4128 35.1644 43.0281L42.387 37.4444C45.0683 35.3715 46.0014 32.1116 46 28.8001L45.9981 20.2653ZM40.7538 25.7573L34.1801 32.4738C33.6538 33.0114 32.8006 33.0114 32.2744 32.4738L29.1284 29.2594C28.6022 28.7218 28.6022 27.85 29.1284 27.3123C29.6546 26.7747 30.5079 26.7747 31.0341 27.3123L33.2273 29.5532L38.8482 23.8102C39.3744 23.2725 40.2276 23.2725 40.7538 23.8102C41.28 24.3478 41.28 25.2196 40.7538 25.7573Z"
            fill="#2B2B2B"
          ></path>
        </svg>
      {% when 'custom' %}
        {% if block.settings.custom_icon != blank %}
          {{
            block.settings.custom_icon
            | image_url: width: 60
            | image_tag: alt: '', width: 30, height: 30, loading: 'lazy'
          }}
        {% endif %}
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
          <path
            d="M96 144C87.2 144 80 151.2 80 160L80 448C80 456.8 87.2 464 96 464L99.3 464C109.7 427.1 143.7 400 184 400C224.3 400 258.2 427.1 268.7 464L371.3 464C376.2 446.6 386.4 431.3 400 420.1L400 160C400 151.2 392.8 144 384 144L96 144zM99.3 512L96 512C60.7 512 32 483.3 32 448L32 160C32 124.7 60.7 96 96 96L384 96C419.3 96 448 124.7 448 160L448 192L503.4 192C520.4 192 536.7 198.7 548.7 210.7L589.3 251.3C601.3 263.3 608 279.6 608 296.6L608 448C608 483.3 579.3 512 544 512L540.7 512C530.3 548.9 496.3 576 456 576C415.7 576 381.8 548.9 371.3 512L268.7 512C258.3 548.9 224.3 576 184 576C143.7 576 109.8 548.9 99.3 512zM448 320L560 320L560 296.6C560 292.4 558.3 288.3 555.3 285.3L514.7 244.7C511.7 241.7 507.6 240 503.4 240L448 240L448 320zM448 368L448 400.4C450.6 400.2 453.3 400 456 400C496.3 400 530.2 427.1 540.7 464L544 464C552.8 464 560 456.8 560 448L560 368L448 368zM184 528C206.1 528 224 510.1 224 488C224 465.9 206.1 448 184 448C161.9 448 144 465.9 144 488C144 510.1 161.9 528 184 528zM456 528C478.1 528 496 510.1 496 488C496 465.9 478.1 448 456 448C433.9 448 416 465.9 416 488C416 510.1 433.9 528 456 528z"
          ></path>
        </svg>
    {% endcase %}
  </div>
  <div class="product-icon-item-content">
    <p class="product-icon-item-title">{{ block.settings.title }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Trust badge",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "shipping", "label": "Shipping" },
        { "value": "returns", "label": "Returns" },
        { "value": "secure", "label": "Secure payment" },
        { "value": "custom", "label": "Custom image" }
      ],
      "default": "shipping"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "visible_if": "{{ block.settings.icon == 'custom' }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Text",
      "default": "Free expedited shipping"
    }
  ],
  "presets": [
    { "name": "Trust badge", "category": "Product" }
  ]
}
{% endschema %}
