{%- doc -%}
  Renders the text side of the image + text section.
{%- enddoc -%}

<div class="img-text-section-content" {{ block.shopify_attributes }}>
  <h1 class="img-text-section-content-title h2">{{ block.settings.title }}</h1>
  <div class="img-text-section-content-text">{{ block.settings.text }}</div>
</div>

{% schema %}
{
  "name": "Content",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Who we are?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your content here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Content"
    }
  ]
}
{% endschema %}
