{%- doc -%}
  Renders a swiper slider of linked collections (category navigation) above the product grid.
  The collections come from a "List of collections" metafield on the current collection,
  rather than a manual picker, so each collection page can show its own sub-categories.

  Create the metafield once in Shopify admin under Settings > Custom data > Collections:
  type "List of collections". The namespace/key below must match what you create there.
{%- enddoc -%}

test {{ collection.metafields.shopify }}

{% liquid
  assign metafield = collection.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
  assign category_list = metafield.value
%}

<div
  class="category-wrapper"
  {{ block.shopify_attributes }}
  {% if category_list == blank and request.design_mode == false %}
    hidden
  {% endif %}
>
  <div class="category-slider-wrapper">
    {% if category_list == blank and request.design_mode %}
      <p class="card-slider-section-placeholder">
        No collections found in the "{{ block.settings.metafield_namespace }}.{{ block.settings.metafield_key }}"
        metafield for this collection.
      </p>
    {% endif %}
    <div class="swiper collection-category-slider">
      <div class="swiper-wrapper">
        {% for category in category_list %}
          {% liquid
            assign category_alt = category.featured_image.alt | default: category.title | escape
          %}
          <div class="swiper-slide">
            <a href="{{ category.url }}" class="category-item">
              <div class="img">
                {% if category.featured_image != blank %}
                  {{ category.featured_image | image_url: width: 200 | image_tag: alt: category_alt, loading: 'lazy' }}
                {% endif %}
              </div>
              <div class="content">
                <p class="title">{{ category.title }}</p>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-button-prev collection-category-button-prev"></div>
      <div class="swiper-button-next collection-category-button-next"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category slider",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "category_slider",
      "info": "Must be a \"List of collections\" metafield defined on the Collection resource."
    }
  ],
  "presets": [
    {
      "name": "Category slider"
    }
  ]
}
{% endschema %}
