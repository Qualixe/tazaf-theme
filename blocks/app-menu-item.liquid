{%- doc -%}
  Renders one item in the fixed mobile bottom app menu.
  The "action" setting decides both the tag (link vs. trigger button) and its
  behavior; the class names it emits (app-menu-open / navbar-search-open-btn /
  cart-drawer-open) are already wired to real JS in assets/script.js, shared
  with the same triggers in the main header.
{%- enddoc -%}

{% liquid
  assign icon_label = block.settings.label
  assign tag = 'a'
  assign extra_class = ''
  assign href = null

  case block.settings.action
    when 'home'
      assign href = routes.root_url
    when 'account'
      assign href = routes.account_url
    when 'link'
      assign href = block.settings.link
    when 'open_menu'
      assign tag = 'button'
      assign extra_class = 'app-menu-open'
    when 'open_search'
      assign tag = 'button'
      assign extra_class = 'navbar-search-open-btn'
    when 'open_cart'
      assign tag = 'button'
      assign extra_class = 'cart-drawer-open'
  endcase
%}

<{{ tag }}
  {% if tag == 'a' %}
    href="{{ href }}"
  {% else %}
    type="button"
  {% endif %}
  class="app-menu-item{% if extra_class != blank %} {{ extra_class }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.action == 'open_cart' and block.settings.show_count %}
    <span class="cart-count">{{ cart.item_count }}</span>
  {% endif %}
