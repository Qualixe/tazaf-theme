{% schema %}
{
  "name": "App menu item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "action",
      "label": "Action",
      "options": [
        { "value": "home", "label": "Go to home page" },
        { "value": "open_menu", "label": "Open menu" },
        { "value": "open_search", "label": "Open search" },
        { "value": "open_cart", "label": "Open cart" },
        { "value": "account", "label": "Go to account page" },
        { "value": "link", "label": "Custom link" }
      ],
      "default": "home"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "visible_if": "{{ block.settings.action == 'link' }}"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show cart count",
      "default": true,
      "visible_if": "{{ block.settings.action == 'open_cart' }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "home", "label": "Home" },
        { "value": "category", "label": "Category" },
        { "value": "search", "label": "Search" },
        { "value": "cart", "label": "Cart" },
        { "value": "account", "label": "Account" }
      ],
      "default": "home"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Home"
    }
  ],
  "presets": [
    {
      "name": "App menu item"
    }
  ]
}
{% endschema %}
