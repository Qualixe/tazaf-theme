{%- doc -%}
  Contact form using this section's own markup/CSS (contact-field-row,
  contact-field-col, contact-btn) instead of the shared Horizon contact-form
  block's layout, wired to Shopify's real {% form 'contact' %} handler: real
  submission, honeypot spam protection, and success/error states.
{%- enddoc -%}

{% assign form_id = block.id | prepend: 'ContactForm-' %}

<div {{ block.shopify_attributes }}>
  {%- form 'contact', id: form_id, class: 'contact-form' -%}
    <input type="hidden" name="contact[id]" value="{{ form_id }}">

    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif
    %}

    {% if form.posted_successfully? and form_matches %}
      <p class="contact-form-message contact-form-message--success">
        Thanks! Your message has been sent.
      </p>
    {% endif %}

    {% if form.errors and form_matches %}
      <p class="contact-form-message contact-form-message--error">
        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
      </p>
    {% endif %}

    <div class="contact-field-row">
      <div class="contact-field-col">
        <input
          type="text"
          name="contact[name]"
          placeholder="Name"
          autocomplete="name"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>
      <div class="contact-field-col">
        <input
          type="email"
          name="contact[email]"
          placeholder="Email"
          autocomplete="email"
          required
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        >
      </div>
    </div>
    <div class="contact-field-col">
      <input
        type="tel"
        name="contact[phone]"
        placeholder="Phone Number"
        autocomplete="tel"
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
      >
    </div>
    <div class="contact-field-col">
      <textarea name="contact[body]" placeholder="Comment" rows="5" cols="81">{{ form.body }}</textarea>
    </div>
    <div class="contact-btn">
      <button class="btn primary-btn" type="submit" aria-label="send button" title="send button">
        send<span></span>
      </button>
    </div>
  {%- endform -%}
</div>

{% stylesheet %}
  .contact-form-message {
    margin: 0 0 16px 0;
    padding: 12px 16px;
    border-radius: 5px;
    font-size: 14px;
  }

  .contact-form-message--success {
    background: rgb(0 128 0 / 10%);
    color: green;
  }

  .contact-form-message--error {
    background: rgb(255 0 0 / 10%);
    color: red;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form (new)",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Contact form (new)"
    }
  ]
}
{% endschema %}
