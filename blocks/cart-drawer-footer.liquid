<div class="cart-drawer-footer" {{ block.shopify_attributes }}>
  <div class="cart-drawer-total-wrap">
    <p class="cart-drawer-total-title">{{ block.settings.total_title | default: 'total' }}</p>
    <p class="cart-drawer-total-price">{{ cart.total_price | money }}</p>
  </div>
  <div class="cart-drawer-checkout-btn-wrap">
    <form action="{{ routes.cart_url }}" method="post">
      
      <button type="submit" name="checkout" class="btn{% if block.settings.enable %} hide_btn{% endif %}">{{ block.settings.checkout_text | default: 'secure checkout' }}</button>
      
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Cart footer",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "total_title",
      "label": "Total title",
      "default": "total"
    },
    {
      "type": "text",
      "id": "checkout_text",
      "label": "Checkout button",
      "default": "secure checkout"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Cart footer",
      "category": "Cart drawer"
    }
  ]
}
{% endschema %}
