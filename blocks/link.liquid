    {% if block.settings.button != blank %}
        <a href="{{ block.settings.link | default: '/collections/all' }}" 
        style="color: {{ block.settings.link_color }}"
        class="button-link">
          {{ block.settings.button }} <span>›</span>
        </a>
      {% endif %}

{% schema %}
{
    "name": "Link",
    "settings": [
        {
            "type": "text",
            "id": "button",
            "label": "Button",
            "default" : "View All"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        },
        {
            "type": "color",
            "id": "link_color",
            "label": "Link Color",
            "default": "{{ settings.color_palette.heading }}"
        }
    ],
    "presets": [
        {
            "name": "Link"
        }
    ]
}
{% endschema %}