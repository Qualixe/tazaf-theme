<div class="product-varient" {{ block.shopify_attributes }}>
  <div class="product-varient-title-wrap">
    <h2 class="product-varient-title">
      <span>{{ block.settings.heading | default: 'Choose combo offer:' }}</span>
    </h2>
  </div>
  <div class="bundle-wrapper">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Combo offer",
  "tag": null,
  "blocks": [
    { "type": "product-info-combo-option" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose combo offer:"
    }
  ],
  "presets": [
    {
      "name": "Combo offer",
      "category": "Product",
      "blocks": {
        "option-1": {
          "type": "product-info-combo-option",
          "settings": { "title": "Buy 1 product", "price": "tk1390.00", "checked": true }
        },
        "option-2": {
          "type": "product-info-combo-option",
          "settings": {
            "title": "Buy 2 product",
            "price": "tk2290.00",
            "unit_price": "tk1145/pair",
            "savings_text": "save 15%",
            "badge_text": "Best Seller"
          }
        },
        "option-3": {
          "type": "product-info-combo-option",
          "settings": {
            "title": "Buy 3 product",
            "price": "tk3030.00",
            "unit_price": "tk1010/pair",
            "savings_text": "save 25%",
            "badge_text": "Best value"
          }
        }
      },
      "block_order": ["option-1", "option-2", "option-3"]
    }
  ]
}
{% endschema %}
