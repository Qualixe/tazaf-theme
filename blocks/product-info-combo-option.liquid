{% liquid assign field_id = 'bundle-' | append: block.id %}
<div class="bundle-item{% if block.settings.badge_text != blank %} badge{% endif %}" {{ block.shopify_attributes }}>
  {% if block.settings.badge_text != blank %}
    <span class="bundle-badge">{{ block.settings.badge_text }}</span>
  {% endif %}
  <input
    type="radio"
    name="bundle-{{ section.id }}"
    value="{{ block.id }}"
    data-qty="{{ block.settings.qty }}"
    id="{{ field_id }}"
    class="bundle_input"
    {% if block.settings.checked %}
      checked
    {% endif %}
  >
  {% assign discnt = block.settings.discount %}
  {% assign qty = block.settings.qty %}
  <label class="bundle-label" for="{{ field_id }}">
    <div class="bundle-content-wrap">
      <div class="bundle-content">
        <p class="bundle-title">{{ block.settings.title }}</p>
        {% if discnt > 0 %}
          <span class="bundle-savings">Save {{ discnt }}%</span>
        {% endif %}
      </div>
      
      <div class="bundle-price">
        <p class="bundle-total-price">{{ product.selected_or_first_available_variant.price  | times: qty |  money_without_trailing_zeros }}</p>
        {% if discnt > 0 %}
          <p class="bundle-single-price">
            {{ product.selected_or_first_available_variant.price |  divided_by: qty |  money_without_trailing_zeros }} / Pair
          </p>
        {% endif %}
      </div>
    </div>
  </label>
</div>

{% schema %}
{
  "name": "Combo option",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "qty",
      "label": "Value",
      "default": 1,
      "placeholder": "Required"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Buy 1 product"
    },
    {
      "type": "range",
      "id": "discount",
      "label": "Discount",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text (optional)"
    },
    {
      "type": "checkbox",
      "id": "checked",
      "label": "Selected by default",
      "default": false
    }
  ],
  "presets": [
    { "name": "Combo option", "category": "Product" }
  ]
}
{% endschema %}
