{%- doc -%}
  Renders the body text in the image + text section.
{%- enddoc -%}

<div class="img-text-section-content-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your content here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
