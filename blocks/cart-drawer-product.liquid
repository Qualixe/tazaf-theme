{% liquid
  assign product_collection = block.settings.collection
  assign max_products = block.settings.max_products | default: 6
%}

{% if product_collection != blank and product_collection.products_count > 0 %}
  <div class="cart-drawer-slider-area" {{ block.shopify_attributes }}>
    <div class="cart-drawer-slider-header">
      <p class="cart-drawer-slider-title">{{ block.settings.heading | default: '66% of shoppers added these too...' }}</p>
      <div class="cart-drawer-slider-btn-wrap">
        <div class="swiper-button-prev cart-drawer-slider-btn-prev"></div>
        <div class="swiper-button-next cart-drawer-slider-btn-next"></div>
      </div>
    </div>

    <div class="swiper cart-drawer-slider">
      <div class="swiper-wrapper">
        {% for product in product_collection.products limit: max_products %}
          <div class="swiper-slide">
            <div class="cart-drawer-slider-item">
              {% render 'slider-product-card', product: product %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Cart Product",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "66% of shoppers added these too..."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "add"
    }
  ],
  "presets": [
    {
      "name": "Cart Product",
      "category": "Cart drawer"
    }
  ]
}
{% endschema %}