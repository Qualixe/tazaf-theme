{% if settings.order_phone_number != blank %}
  <a href="tel:{{ block.settings.number | remove: ' ' }}" class="btn callNow" {{ block.shopify_attributes }}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path
        d="M6.6 3.5 9 3l2 4-2 1.5a13 13 0 0 0 6.5 6.5L17 13l4 2-.5 2.4a3 3 0 0 1-3.2 2.4C10.4 19 5 13.6 4.2 6.7A3 3 0 0 1 6.6 3.5Z"
      ></path>
      <path d="M15.5 4.5a6 6 0 0 1 4 4"></path>
      <path d="M15.5 7.5a3 3 0 0 1 1.5 1.5"></path>
    </svg>
    {{ block.settings.button }}
  </a>
{% endif %}

{% schema %}
{
  "name": "Call button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default" : "Call for Order"
    },
    {
      "type": "number",
      "id": "number",
      "label": "Number",
      "default" : 8801318552266
    }
  ],
  "presets": [
    { "name": "Call button", "category": "Product" }
  ]
}
{% endschema %}
